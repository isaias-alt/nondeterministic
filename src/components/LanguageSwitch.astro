---
import { languageSwitch, type Locale } from "../i18n/ui";

interface Props {
  /** The language to switch to and the URL of this page in it. */
  alternate: { lang: Locale; href: string };
  class?: string;
}

const { alternate, class: className } = Astro.props;
const { label, title } = languageSwitch[alternate.lang];
---

<a
  href={alternate.href}
  lang={alternate.lang}
  hreflang={alternate.lang}
  title={title}
  aria-label={title}
  class={className}>{label}</a
>
