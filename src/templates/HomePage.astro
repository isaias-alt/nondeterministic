---
import Layout from "../layouts/Layout.astro";
import { formatDate, getLang, t } from "../i18n/ui";
import type { PostListItem } from "../lib/views";

interface Props {
  /** Already sorted, newest first. */
  posts: PostListItem[];
  ogImage: string;
}

const { posts, ogImage } = Astro.props;
const lang = getLang(Astro.currentLocale);
const description = t(lang, "home.description");

const postsByYear = new Map<number, PostListItem[]>();
for (const post of posts) {
  const year = post.pubDate.getUTCFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}
const years = [...postsByYear.keys()].sort((a, b) => b - a);
---

<Layout title="nondeterministic" description={description} ogImage={ogImage}>
  <div class="mx-auto max-w-195 px-6">
    <div class="pt-[clamp(56px,10vh,96px)] pb-2">
      <h1
        class="font-archivo text-[clamp(34px,6vw,52px)] leading-[1.02] font-extrabold tracking-[-0.035em] text-bone"
      >
        nondeterministic<span class="text-steel">.</span>
      </h1>
      <p class="mt-4 max-w-[52ch] text-[15px] text-fog">
        {description}
      </p>
    </div>

    <div class="pt-10 pb-6">
      {
        years.map((year) => (
          <div>
            <span class="block border-b border-line py-2.5 pt-6 font-mono text-xs tracking-wider text-steel-dim-text">
              {year}
            </span>
            {postsByYear.get(year)!.map((post) => (
              <a
                href={post.href}
                class="group flex items-baseline gap-5 border-b border-line py-4 no-underline text-inherit transition-[padding-left] duration-200 ease-out hover:pl-2"
              >
                <span class="min-w-18.5 font-mono text-xs whitespace-nowrap text-fog max-[640px]:min-w-16">
                  {formatDate(lang, post.pubDate, "short")}
                </span>
                <div class="flex-1">
                  <div class="font-archivo text-[19px] leading-tight font-semibold tracking-[-0.02em] text-bone transition-colors duration-150 group-hover:text-steel-text">
                    {post.title}
                  </div>
                  <div class="mt-1 text-sm leading-normal text-fog">
                    {post.description}
                  </div>
                  {post.seriesTitle && (
                    <span class="mt-2 inline-block rounded-sm border border-steel-dim px-1.5 py-0.5 font-mono text-[10px] tracking-[0.06em] text-steel-text uppercase">
                      {t(lang, "series.singular")} · {post.seriesTitle}
                    </span>
                  )}
                </div>
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</Layout>
