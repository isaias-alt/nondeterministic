---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const allSeries = await getCollection("series");
const allPosts = await getCollection(
  "posts",
  ({ data }) => !import.meta.env.PROD || !data.draft,
);

// A series with no qualifying posts (e.g. all its posts are draft) has
// nothing to show and shouldn't be listed.
const seriesWithCount = allSeries
  .map((series) => ({
    series,
    count: allPosts.filter((post) => post.data.series?.id === series.id).length,
  }))
  .filter(({ count }) => count > 0);
---

<Layout
  title="Series - nondeterministic"
  description="Multi-part deep dives from nondeterministic. Read top to bottom, or jump in wherever."
>
  <div class="mx-auto max-w-195 px-6">
    <div class="pt-[clamp(56px,10vh,96px)] pb-4">
      <h1
        class="font-archivo text-[clamp(34px,6vw,52px)] leading-[1.02] font-extrabold tracking-[-0.035em] text-bone"
      >
        Series<span class="text-steel">.</span>
      </h1>
      <p class="mt-4 max-w-[52ch] text-[15px] text-fog">
        Multi-part deep dives. Read top to bottom, or jump in wherever.
      </p>
    </div>

    {
      seriesWithCount.length === 0 ? (
        <p class="py-6 pb-12 font-mono text-[13px] text-fog">
          None published yet.
        </p>
      ) : (
        <div class="grid gap-5 pt-9 pb-6">
          {seriesWithCount.map(({ series, count }) => (
            <a
              href={`/series/${series.id}`}
              class="flex gap-5 rounded border border-line bg-surface p-4.5 no-underline text-inherit transition-colors duration-200 hover:border-steel-dim max-[640px]:flex-col"
            >
              <div class="aspect-square w-30 shrink-0 overflow-hidden rounded-[3px] border border-line max-[640px]:aspect-16/7 max-[640px]:w-full">
                <Image
                  src={series.data.cover}
                  alt={series.data.title}
                  class="h-full w-full object-cover"
                />
              </div>
              <div>
                <h3 class="font-archivo text-xl font-bold tracking-[-0.02em] text-bone">
                  {series.data.title}
                </h3>
                <div class="mt-1.5 font-mono text-[11px] text-steel-text">
                  {count} {count === 1 ? "part" : "parts"}
                </div>
                <p class="mt-2 text-sm leading-normal text-fog">
                  {series.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Layout>
