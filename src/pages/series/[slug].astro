---
import SeriesPage from "../../templates/SeriesPage.astro";
import { getSeriesIds, getSeriesView } from "../../lib/content";

export async function getStaticPaths() {
  // A series with no published posts has nothing to land on and gets no page.
  const ids = await getSeriesIds("en");
  return ids.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const series = await getSeriesView("en", slug);
---

<SeriesPage series={series} />
