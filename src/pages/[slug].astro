---
import PostPage from "../templates/PostPage.astro";
import { getPostSlugs, getPostView } from "../lib/content";
import { homeUrl, postOgPath } from "../lib/urls";

export async function getStaticPaths() {
  const slugs = await getPostSlugs("en");
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getPostView("en", slug);
---

<PostPage post={post} homeHref={homeUrl("en")} ogImage={postOgPath("en", slug)} />
